{
  "$ref": "#/definitions/blinds",
  "definitions": {
    "blinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "flashId": {
            "type": [
              "string",
              "null"
            ]
          },
          "flasherSteamId64": {
            "type": "string",
            "pattern": "^\\d{17}$"
          },
          "flashedSteamId64": {
            "type": "string",
            "pattern": "^\\d{17}$"
          },
          "flasherTeamKey": {
            "type": "string",
            "enum": [
              "teamA",
              "teamB"
            ]
          },
          "flashedTeamKey": {
            "type": "string",
            "enum": [
              "teamA",
              "teamB"
            ]
          },
          "flasherSide": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "flashedSide": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
          }
        },
        "required": [
          "roundNumber",
          "tick",
          "flashId",
          "flasherSteamId64",
          "flashedSteamId64",
          "flasherTeamKey",
          "flashedTeamKey",
          "flasherSide",
          "flashedSide",
          "durationSeconds"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
