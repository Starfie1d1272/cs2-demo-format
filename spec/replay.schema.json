{
  "$ref": "#/definitions/replay",
  "definitions": {
    "replay": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "sampleRate": {
              "type": "integer",
              "minimum": 1
            },
            "tickrate": {
              "type": "integer",
              "minimum": 1
            },
            "coordScale": {
              "type": "integer",
              "minimum": 1
            },
            "angleScale": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "sampleRate",
            "tickrate",
            "coordScale",
            "angleScale"
          ],
          "additionalProperties": false
        },
        "weaponDict": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "placeDict": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "roundNumber": {
                "type": "integer",
                "minimum": 1
              },
              "startTick": {
                "type": "integer",
                "minimum": 1
              },
              "tickStep": {
                "type": "integer",
                "minimum": 1
              },
              "frameCount": {
                "type": "integer",
                "minimum": 0
              },
              "players": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "playerIndex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "x": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "y": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "z": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "yaw": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "pitch": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "hp": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "armor": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "money": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "equipValue": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "weapon": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -1
                      }
                    },
                    "place": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -1
                      }
                    },
                    "flash": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  },
                  "required": [
                    "playerIndex",
                    "x",
                    "y",
                    "z",
                    "yaw",
                    "pitch",
                    "hp",
                    "armor",
                    "money",
                    "equipValue",
                    "weapon",
                    "place",
                    "flash",
                    "flags"
                  ],
                  "additionalProperties": false
                }
              },
              "projectiles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "grenade": {
                      "type": "string",
                      "enum": [
                        "flashbang",
                        "smoke",
                        "molotov",
                        "incendiary",
                        "hegrenade",
                        "decoy"
                      ]
                    },
                    "throwerIndex": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "startTick": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "x": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "y": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "z": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  },
                  "required": [
                    "grenade",
                    "throwerIndex",
                    "startTick",
                    "x",
                    "y",
                    "z"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "roundNumber",
              "startTick",
              "tickStep",
              "frameCount",
              "players",
              "projectiles"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "meta",
        "weaponDict",
        "placeDict",
        "rounds"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
