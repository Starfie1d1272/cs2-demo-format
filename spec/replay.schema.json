{
  "$ref": "#/definitions/replay",
  "definitions": {
    "replay": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "sampleRate": {
              "type": "integer",
              "minimum": 1
            },
            "tickrate": {
              "type": "integer",
              "minimum": 1
            },
            "coordScale": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "sampleRate",
            "tickrate",
            "coordScale"
          ],
          "additionalProperties": false
        },
        "weaponDict": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "roundNumber": {
                "type": "integer",
                "minimum": 1
              },
              "startTick": {
                "type": "integer",
                "minimum": 1
              },
              "tickStep": {
                "type": "integer",
                "minimum": 1
              },
              "frameCount": {
                "type": "integer",
                "minimum": 0
              },
              "players": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "steamId64": {
                      "type": "string",
                      "pattern": "^\\d{17}$"
                    },
                    "teamKey": {
                      "type": "string",
                      "enum": [
                        "teamA",
                        "teamB"
                      ]
                    },
                    "side": {
                      "type": "string",
                      "enum": [
                        "t",
                        "ct"
                      ]
                    },
                    "x": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "y": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "z": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "yaw": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "hp": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "weapon": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -1
                      }
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 15
                      }
                    }
                  },
                  "required": [
                    "steamId64",
                    "teamKey",
                    "side",
                    "x",
                    "y",
                    "z",
                    "yaw",
                    "hp",
                    "weapon",
                    "flags"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "roundNumber",
              "startTick",
              "tickStep",
              "frameCount",
              "players"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "meta",
        "weaponDict",
        "rounds"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
