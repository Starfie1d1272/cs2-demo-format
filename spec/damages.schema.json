{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "roundNumber": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "tick": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "attackerIndex": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "victimIndex": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "weapon": {
        "type": "string",
        "minLength": 1
      },
      "hitgroup": {
        "type": "string",
        "enum": [
          "generic",
          "head",
          "chest",
          "stomach",
          "left_arm",
          "right_arm",
          "left_leg",
          "right_leg",
          "gear",
          "neck"
        ]
      },
      "healthDamage": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "healthDamageRaw": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "armorDamage": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "victimHealthBefore": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "victimArmorAfter": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "attackerPosition": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "z": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "victimPosition": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "z": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "roundNumber",
      "tick",
      "attackerIndex",
      "victimIndex",
      "weapon",
      "hitgroup",
      "healthDamage",
      "healthDamageRaw",
      "armorDamage",
      "victimHealthBefore",
      "victimArmorAfter",
      "attackerPosition",
      "victimPosition"
    ],
    "additionalProperties": false
  }
}
