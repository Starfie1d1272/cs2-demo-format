{
  "$ref": "#/definitions/damages",
  "definitions": {
    "damages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "attackerSteamId64": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{17}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "victimSteamId64": {
            "type": "string",
            "pattern": "^\\d{17}$"
          },
          "attackerTeamKey": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "teamA",
                  "teamB"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "victimTeamKey": {
            "type": "string",
            "enum": [
              "teamA",
              "teamB"
            ]
          },
          "attackerSide": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "t",
                  "ct"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "victimSide": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "weapon": {
            "type": "string",
            "minLength": 1
          },
          "hitgroup": {
            "type": "string",
            "enum": [
              "generic",
              "head",
              "chest",
              "stomach",
              "left_arm",
              "right_arm",
              "left_leg",
              "right_leg",
              "gear",
              "neck"
            ]
          },
          "healthDamage": {
            "type": "integer",
            "minimum": 0
          },
          "healthDamageRaw": {
            "type": "integer",
            "minimum": 0
          },
          "armorDamage": {
            "type": "integer",
            "minimum": 0
          },
          "victimHealthBefore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "victimHealthAfter": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "victimArmorBefore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "victimArmorAfter": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "attackerPosition": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "victimPosition": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "roundNumber",
          "tick",
          "attackerSteamId64",
          "victimSteamId64",
          "attackerTeamKey",
          "victimTeamKey",
          "attackerSide",
          "victimSide",
          "weapon",
          "hitgroup",
          "healthDamage",
          "healthDamageRaw",
          "armorDamage",
          "victimHealthBefore",
          "victimHealthAfter",
          "victimArmorBefore",
          "victimArmorAfter",
          "attackerPosition",
          "victimPosition"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
