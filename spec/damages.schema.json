{
  "$ref": "#/definitions/damages",
  "definitions": {
    "damages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "attackerIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "victimIndex": {
            "type": "integer",
            "minimum": 0
          },
          "weapon": {
            "type": "string",
            "minLength": 1
          },
          "hitgroup": {
            "type": "string",
            "enum": [
              "generic",
              "head",
              "chest",
              "stomach",
              "left_arm",
              "right_arm",
              "left_leg",
              "right_leg",
              "gear",
              "neck"
            ]
          },
          "healthDamage": {
            "type": "integer",
            "minimum": 0
          },
          "healthDamageRaw": {
            "type": "integer",
            "minimum": 0
          },
          "armorDamage": {
            "type": "integer",
            "minimum": 0
          },
          "victimHealthBefore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "victimArmorAfter": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "attackerPosition": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer"
                  },
                  "y": {
                    "type": "integer"
                  },
                  "z": {
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "victimPosition": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "z": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "roundNumber",
          "tick",
          "attackerIndex",
          "victimIndex",
          "weapon",
          "hitgroup",
          "healthDamage",
          "healthDamageRaw",
          "armorDamage",
          "victimHealthBefore",
          "victimArmorAfter",
          "attackerPosition",
          "victimPosition"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
