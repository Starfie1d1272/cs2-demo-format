{
  "$ref": "#/definitions/manifest",
  "definitions": {
    "manifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "cs2-demo-format/2.0"
        },
        "exporter": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "parser": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "demo": {
          "type": "object",
          "properties": {
            "hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceFileName": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "hash",
            "sourceFileName"
          ],
          "additionalProperties": false
        },
        "mapName": {
          "type": "string",
          "minLength": 1
        },
        "tickrate": {
          "type": "integer",
          "minimum": 1
        },
        "exportedAt": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "properties": {
            "match": {
              "type": "string",
              "minLength": 1
            },
            "players": {
              "type": "string",
              "minLength": 1
            },
            "rounds": {
              "type": "string",
              "minLength": 1
            },
            "playerStats": {
              "type": "string",
              "minLength": 1
            },
            "playerEconomies": {
              "type": "string",
              "minLength": 1
            },
            "kills": {
              "type": "string",
              "minLength": 1
            },
            "damages": {
              "type": "string",
              "minLength": 1
            },
            "blinds": {
              "type": "string",
              "minLength": 1
            },
            "bombs": {
              "type": "string",
              "minLength": 1
            },
            "grenades": {
              "type": "string",
              "minLength": 1
            },
            "clutches": {
              "type": "string",
              "minLength": 1
            },
            "shots": {
              "type": "string",
              "minLength": 1
            },
            "positions1s": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "match",
            "players",
            "rounds",
            "playerStats",
            "playerEconomies",
            "kills",
            "damages",
            "blinds",
            "bombs",
            "grenades",
            "clutches"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "exporter",
        "parser",
        "demo",
        "mapName",
        "tickrate",
        "exportedAt",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
