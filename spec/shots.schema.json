{
  "$ref": "#/definitions/shots",
  "definitions": {
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "steamId64": {
            "type": "string",
            "pattern": "^\\d{17}$"
          },
          "teamKey": {
            "type": "string",
            "enum": [
              "teamA",
              "teamB"
            ]
          },
          "side": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "weapon": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "velocity": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "yaw": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "pitch": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        },
        "required": [
          "roundNumber",
          "tick",
          "steamId64",
          "teamKey",
          "side",
          "weapon",
          "position",
          "velocity",
          "yaw",
          "pitch"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
