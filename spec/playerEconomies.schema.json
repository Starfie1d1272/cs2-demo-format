{
  "$ref": "#/definitions/playerEconomies",
  "definitions": {
    "playerEconomies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "playerIndex": {
            "type": "integer",
            "minimum": 0
          },
          "startMoney": {
            "type": "integer",
            "minimum": 0
          },
          "moneySpent": {
            "type": "integer",
            "minimum": 0
          },
          "equipmentValue": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "pistol",
              "eco",
              "semi",
              "force",
              "full"
            ]
          },
          "hasArmor": {
            "type": "boolean"
          },
          "hasHelmet": {
            "type": "boolean"
          },
          "hasDefuseKit": {
            "type": "boolean"
          },
          "primaryWeapon": {
            "type": [
              "string",
              "null"
            ]
          },
          "secondaryWeapon": {
            "type": [
              "string",
              "null"
            ]
          },
          "grenadeCount": {
            "type": "integer",
            "minimum": 0
          },
          "grenades": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "flashbang",
                "smoke",
                "molotov",
                "incendiary",
                "hegrenade",
                "decoy"
              ]
            },
            "default": []
          }
        },
        "required": [
          "roundNumber",
          "playerIndex",
          "startMoney",
          "moneySpent",
          "equipmentValue",
          "type",
          "hasArmor",
          "hasHelmet",
          "hasDefuseKit",
          "primaryWeapon",
          "secondaryWeapon",
          "grenadeCount"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
