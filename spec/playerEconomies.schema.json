{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "roundNumber": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "playerIndex": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "startMoney": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "moneySpent": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "equipmentValue": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "type": {
        "type": "string",
        "enum": [
          "pistol",
          "eco",
          "semi",
          "force",
          "full"
        ]
      },
      "hasArmor": {
        "type": "boolean"
      },
      "hasHelmet": {
        "type": "boolean"
      },
      "hasDefuseKit": {
        "type": "boolean"
      },
      "primaryWeapon": {
        "type": [
          "string",
          "null"
        ]
      },
      "secondaryWeapon": {
        "type": [
          "string",
          "null"
        ]
      },
      "grenadeCount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "grenades": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "flashbang",
            "smoke",
            "molotov",
            "incendiary",
            "hegrenade",
            "decoy"
          ]
        }
      }
    },
    "required": [
      "roundNumber",
      "playerIndex",
      "startMoney",
      "moneySpent",
      "equipmentValue",
      "type",
      "hasArmor",
      "hasHelmet",
      "hasDefuseKit",
      "primaryWeapon",
      "secondaryWeapon",
      "grenadeCount",
      "grenades"
    ],
    "additionalProperties": false
  }
}
