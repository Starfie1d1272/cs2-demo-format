{
  "$ref": "#/definitions/playerEconomies",
  "definitions": {
    "playerEconomies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer"
          },
          "steamId64": {
            "type": "string"
          },
          "teamKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "side": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "t",
                  "ct",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "startMoney": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "moneySpent": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "equipmentValue": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pistol",
                  "eco",
                  "semi",
                  "force",
                  "full"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "roundNumber",
          "steamId64"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
