{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "roundNumber": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "tick": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "type": {
        "type": "string",
        "enum": [
          "plant_begin",
          "planted",
          "defuse_begin",
          "defused",
          "exploded",
          "dropped",
          "picked_up"
        ]
      },
      "site": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "a",
              "b"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "actorIndex": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "position": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "z": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "roundNumber",
      "tick",
      "type",
      "site",
      "actorIndex",
      "position"
    ],
    "additionalProperties": false
  }
}
