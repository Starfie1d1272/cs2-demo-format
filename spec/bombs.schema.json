{
  "$ref": "#/definitions/bombs",
  "definitions": {
    "bombs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "plant_begin",
              "planted",
              "defuse_begin",
              "defused",
              "exploded",
              "dropped",
              "picked_up"
            ]
          },
          "site": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "a",
                  "b"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "actorIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "z": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "roundNumber",
          "tick",
          "type",
          "site",
          "actorIndex",
          "position"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
