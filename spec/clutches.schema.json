{
  "$ref": "#/definitions/clutches",
  "definitions": {
    "clutches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "clutcherSteamId64": {
            "type": "string",
            "pattern": "^\\d{17}$"
          },
          "clutcherTeamKey": {
            "type": "string",
            "enum": [
              "teamA",
              "teamB"
            ]
          },
          "clutcherSide": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "opponentCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "won": {
            "type": "boolean"
          },
          "survived": {
            "type": "boolean"
          },
          "killCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "required": [
          "roundNumber",
          "tick",
          "clutcherSteamId64",
          "clutcherTeamKey",
          "clutcherSide",
          "opponentCount",
          "won",
          "survived",
          "killCount"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
