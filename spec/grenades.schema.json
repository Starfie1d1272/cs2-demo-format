{
  "$ref": "#/definitions/grenades",
  "definitions": {
    "grenades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "grenadeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "throwTick": {
            "type": "integer",
            "minimum": 1
          },
          "effectTick": {
            "type": "integer",
            "minimum": 1
          },
          "destroyTick": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "grenade": {
            "type": "string",
            "enum": [
              "flashbang",
              "smoke",
              "molotov",
              "incendiary",
              "hegrenade",
              "decoy"
            ]
          },
          "throwerSteamId64": {
            "type": "string",
            "pattern": "^\\d{17}$"
          },
          "throwerTeamKey": {
            "type": "string",
            "enum": [
              "teamA",
              "teamB"
            ]
          },
          "throwerSide": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "throwPosition": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "effectPosition": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "roundNumber",
          "grenadeId",
          "throwTick",
          "effectTick",
          "destroyTick",
          "grenade",
          "throwerSteamId64",
          "throwerTeamKey",
          "throwerSide",
          "throwPosition",
          "effectPosition"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
