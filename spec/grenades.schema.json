{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "roundNumber": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "grenadeId": {
        "type": [
          "string",
          "null"
        ]
      },
      "throwTick": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "effectTick": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "destroyTick": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "grenade": {
        "type": "string",
        "enum": [
          "flashbang",
          "smoke",
          "molotov",
          "incendiary",
          "hegrenade",
          "decoy"
        ]
      },
      "throwerIndex": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "throwPosition": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "z": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "additionalProperties": false
      },
      "effectPosition": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "z": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "roundNumber",
      "grenadeId",
      "throwTick",
      "effectTick",
      "destroyTick",
      "grenade",
      "throwerIndex",
      "throwPosition",
      "effectPosition"
    ],
    "additionalProperties": false
  }
}
