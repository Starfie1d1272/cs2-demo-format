{
  "$ref": "#/definitions/positions1s",
  "definitions": {
    "positions1s": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "steamId64": {
            "type": "string",
            "pattern": "^\\d{17}$"
          },
          "teamKey": {
            "type": "string",
            "enum": [
              "teamA",
              "teamB"
            ]
          },
          "side": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "alive": {
            "type": "boolean"
          },
          "position": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "yaw": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "null"
              }
            ]
          },
          "pitch": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "null"
              }
            ]
          },
          "health": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "armor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "money": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16000
          },
          "activeWeapon": {
            "type": [
              "string",
              "null"
            ]
          },
          "flashDurationRemaining": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
          },
          "hasBomb": {
            "type": "boolean"
          },
          "hasDefuseKit": {
            "type": "boolean"
          }
        },
        "required": [
          "roundNumber",
          "tick",
          "steamId64",
          "teamKey",
          "side",
          "alive",
          "position",
          "yaw",
          "pitch",
          "health",
          "armor",
          "money",
          "activeWeapon",
          "flashDurationRemaining",
          "hasBomb",
          "hasDefuseKit"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
