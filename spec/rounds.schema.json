            "minimum": 1
          },
          "teamASide": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "teamBSide": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "teamAScoreBefore": {
