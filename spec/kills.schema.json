{
  "$ref": "#/definitions/kills",
  "definitions": {
    "kills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "killerSteamId64": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{17}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "victimSteamId64": {
            "type": "string",
            "pattern": "^\\d{17}$"
          },
          "assisterSteamId64": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{17}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "flashAssisterSteamId64": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{17}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "killerTeamKey": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "teamA",
                  "teamB"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "victimTeamKey": {
            "type": "string",
            "enum": [
              "teamA",
              "teamB"
            ]
          },
          "killerSide": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "t",
                  "ct"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "victimSide": {
            "type": "string",
            "enum": [
              "t",
              "ct"
            ]
          },
          "weapon": {
            "type": "string",
            "minLength": 1
          },
          "killerActiveWeapon": {
            "type": [
              "string",
              "null"
            ]
          },
          "victimActiveWeapon": {
            "type": [
              "string",
              "null"
            ]
          },
          "headshot": {
            "type": "boolean"
          },
          "flashAssist": {
            "type": "boolean"
          },
          "tradeKill": {
            "type": "boolean"
          },
          "tradeDeath": {
            "type": "boolean"
          },
          "throughSmoke": {
            "type": "boolean"
          },
          "noScope": {
            "type": "boolean"
          },
          "penetratedObjects": {
            "type": "integer",
            "minimum": 0
          },
          "killerPosition": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "victimPosition": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "roundNumber",
          "tick",
          "killerSteamId64",
          "victimSteamId64",
          "assisterSteamId64",
          "flashAssisterSteamId64",
          "killerTeamKey",
          "victimTeamKey",
          "killerSide",
          "victimSide",
          "weapon",
          "killerActiveWeapon",
          "victimActiveWeapon",
          "headshot",
          "flashAssist",
          "tradeKill",
          "tradeDeath",
          "throughSmoke",
          "noScope",
          "penetratedObjects",
          "killerPosition",
          "victimPosition"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
