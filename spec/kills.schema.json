{
  "$ref": "#/definitions/kills",
  "definitions": {
    "kills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "killerIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "victimIndex": {
            "type": "integer",
            "minimum": 0
          },
          "assisterIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "flashAssisterIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "weapon": {
            "type": "string",
            "minLength": 1
          },
          "killerActiveWeapon": {
            "type": [
              "string",
              "null"
            ]
          },
          "victimActiveWeapon": {
            "type": [
              "string",
              "null"
            ]
          },
          "headshot": {
            "type": "boolean"
          },
          "flashAssist": {
            "type": "boolean"
          },
          "tradeKill": {
            "type": "boolean"
          },
          "tradeDeath": {
            "type": "boolean"
          },
          "throughSmoke": {
            "type": "boolean"
          },
          "noScope": {
            "type": "boolean"
          },
          "penetratedObjects": {
            "type": "integer",
            "minimum": 0
          },
          "killerPosition": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer"
                  },
                  "y": {
                    "type": "integer"
                  },
                  "z": {
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "victimPosition": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "z": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "roundNumber",
          "tick",
          "killerIndex",
          "victimIndex",
          "assisterIndex",
          "flashAssisterIndex",
          "weapon",
          "killerActiveWeapon",
          "victimActiveWeapon",
          "headshot",
          "flashAssist",
          "tradeKill",
          "tradeDeath",
          "throughSmoke",
          "noScope",
          "penetratedObjects",
          "killerPosition",
          "victimPosition"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
