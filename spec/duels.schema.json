{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "tickrate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "coordScale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "angleScale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "windowBeforeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "windowAfterMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tickrate",
        "sampleRate",
        "coordScale",
        "angleScale",
        "windowBeforeMs",
        "windowAfterMs"
      ],
      "additionalProperties": false
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roundNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "startTick": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "tickStep": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "frameCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "anchors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "kill",
                    "damage"
                  ]
                },
                "tick": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "attackerIndex": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "victimIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "tick",
                "attackerIndex",
                "victimIndex"
              ],
              "additionalProperties": false
            }
          },
          "players": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "playerIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "x": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "y": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "z": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "yaw": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "pitch": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "hp": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "flash": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                }
              },
              "required": [
                "playerIndex",
                "x",
                "y",
                "z",
                "yaw",
                "pitch",
                "hp",
                "flash"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "roundNumber",
          "startTick",
          "tickStep",
          "frameCount",
          "anchors",
          "players"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "windows"
  ],
  "additionalProperties": false
}
