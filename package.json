{
  "name": "cs2-demo-format",
  "version": "5.0.0",
  "description": "Implementation-neutral CS2 demo export format with ZIP schemas, TypeScript types, and validators",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starfie1d1272/cs2-demo-format.git"
  },
  "main": "schemas/index.ts",
  "types": "schemas/index.ts",
  "files": [
    "schemas/",
    "parser/",
    "spec/",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./schemas/index.ts",
    "./parser": "./parser/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:versions": "tsx scripts/check-versions.ts",
    "test:parser": "tsx scripts/test-parser.ts",
    "gen:schema": "tsx scripts/gen-json-schema.ts",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "format": "prettier --write \"{parser,schemas,scripts}/**/*.{ts,js,mjs,cjs}\" --ignore-unknown",
    "format:check": "prettier --check \"{parser,schemas,scripts}/**/*.{ts,js,mjs,cjs}\" --ignore-unknown",
    "lint": "biome lint parser schemas scripts --diagnostic-level=error"
  },
  "keywords": [
    "cs2",
    "demo",
    "esports",
    "schema"
  ],
  "packageManager": "pnpm@12.23.0",
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@changesets/cli": "^3.1.0",
    "@types/node": "^26.6.11",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": ">=4.6.6 <5"
  }
}
