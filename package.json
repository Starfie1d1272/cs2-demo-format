{
  "name": "cs2-demo-format",
  "version": "3.1.0",
  "description": "Implementation-neutral CS2 demo export format with ZIP schemas, TypeScript types, and validators",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starfie1d1272/cs2-demo-format.git"
  },
  "main": "schemas/index.ts",
  "types": "schemas/index.ts",
  "files": [
    "schemas/",
    "parser/",
    "spec/",
    "docs/",
    "tools/validate.py",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./schemas/index.ts",
    "./parser": "./parser/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:versions": "python3 tools/check_versions.py",
    "gen:schema": "tsx scripts/gen-json-schema.ts",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts"
  },
  "keywords": [
    "cs2",
    "demo",
    "esports",
    "schema"
  ],
  "packageManager": "pnpm@12.9.1",
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "zod": ">=4.6.5 <5"
  }
}
