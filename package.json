{
  "name": "cs2-demo-format",
  "version": "2.0.0",
  "description": "Implementation-neutral CS2 demo export format with ZIP schemas, TypeScript types, and validators",
  "main": "schemas/index.ts",
  "types": "schemas/index.ts",
  "files": [
    "schemas/",
    "parser/",
    "spec/",
    "docs/",
    "tools/validate.py",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./schemas/index.ts",
    "./parser": "./parser/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:schema": "tsx scripts/gen-json-schema.ts",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts"
  },
  "keywords": [
    "cs2",
    "demo",
    "esports",
    "schema"
  ],
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.0.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "peerDependencies": {
    "zod": ">=3.0.0"
  }
}
