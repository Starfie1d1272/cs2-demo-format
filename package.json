{
  "name": "cs2-demo-format",
  "version": "1.3.0",
  "description": "CS2 Demo Export Format Specification — ZIP schema, TypeScript types, and reference parser",
  "main": "schemas/index.ts",
  "types": "schemas/index.ts",
  "exports": {
    ".": "./schemas/index.ts",
    "./parser": "./parser/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:schema": "tsx scripts/gen-json-schema.ts",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts"
  },
  "keywords": [
    "cs2",
    "demo",
    "esports",
    "schema"
  ],
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.0.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "peerDependencies": {
    "zod": ">=3.0.0"
  }
}
